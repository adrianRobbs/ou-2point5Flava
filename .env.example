# TheStatsAPI
THESTATSAPI_KEY=
THESTATSAPI_BASE_URL=https://api.thestatsapi.com/api

# Rate limiting — match your plan tier (Starter=120, Growth=300, Scale=1000)
THESTATSAPI_RATE_LIMIT_PER_MIN=120

# Neon Postgres — use the pooled connection string (pgbouncer-enabled endpoint)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require

LOG_LEVEL=INFO

# --- Backfill-management page (webapp/routers/backfill.py) ---
# All optional — unset locally, the feature 501s cleanly rather than the
# app failing to start (see config.py). Set on the ou25-webapp Render
# service only, never the cron jobs.
RENDER_API_KEY=
RENDER_SERVICE_ID=
BACKFILL_ADMIN_TOKEN=

# --- Deployment (GitHub Actions secrets, not read by the app itself) ---
# RENDER_API_KEY, RENDER_WEB_SERVICE_ID, RENDER_DISCOVER_CRON_ID,
# RENDER_REFRESH_DAYTIME_CRON_ID, RENDER_REFRESH_LATE_CRON_ID
# — see .github/workflows/deploy.yml. Same Render account API key as
# RENDER_API_KEY above, but this is a *separate* GitHub secret — GitHub
# Actions can't read Render's dashboard env vars, so it needs its own copy.
# DATABASE_URL/THESTATSAPI_KEY are set directly in the Render dashboard per
# service (render.yaml marks them sync: false), not passed through this
# workflow either.
